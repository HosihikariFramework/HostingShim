<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Probe</AssemblyName>
  </PropertyGroup>

  <!-- 探针是验证脚手架，不是插件样例：它按相对路径指向本仓的兄弟检出，
       不进分发。共享层上的程序集都 ExcludeAssets="runtime"，运行时由载体提供。 -->
  <ItemGroup>
    <ProjectReference
      Include="../../../../Plugin.Abstractions/src/Hosihikari.Plugin.Abstractions.csproj"
      Private="false"
      ExcludeAssets="runtime"
    />
    <ProjectReference
      Include="../../../../Plugin.Abstractions/model/Hosihikari.Plugin.Models.csproj"
      Private="false"
      ExcludeAssets="runtime"
    />
    <ProjectReference
      Include="../../../../../Projection/Capabilities/src/Hosihikari.Extension.Abstractions/Hosihikari.Extension.Abstractions.csproj"
      Private="false"
      ExcludeAssets="runtime"
    />
    <ProjectReference
      Include="../../../../../Projection/Capabilities/src/Hosihikari.Extension.Event/Hosihikari.Extension.Event.csproj"
      Private="false"
      ExcludeAssets="runtime"
    />
  </ItemGroup>
</Project>
